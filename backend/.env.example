# LLM provider: "mock" (default, deterministic, no network) or "gemini"
LLM_PROVIDER=mock
# Google Gemini API key (https://aistudio.google.com/apikey). Leave empty while
# LLM_PROVIDER=mock; fill it in and set LLM_PROVIDER=gemini to use the real model.
GEMINI_API_KEY=
# Gemini model id (only used when LLM_PROVIDER=gemini)
GEMINI_MODEL=gemini-2.5-flash
# Database (SQLite file inside backend/)
DATABASE_URL=sqlite:///./app.db
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# JWT signing secret (change in any real deployment) and token lifetime
# at least 32 characters (HS256 recommendation)
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_EXPIRES_MINUTES=720
# --- RAG (S3) ---
# Multilingual embedding model (local sentence-transformers, no API key).
# e5 models need the "query:" / "passage:" prefixes below; for other models
# set both to an empty value.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# Chroma vector store (relative paths resolve against backend/)
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=uniagent_documents
# Where admin-uploaded documents are stored (S13)
UPLOADS_PATH=./uploads
