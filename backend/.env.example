# LLM provider: "mock" (default, deterministic, no network) or "gemini"
LLM_PROVIDER=mock
# Google Gemini API key (connected at the end of the project, leave empty for now)
GEMINI_API_KEY=
# Database (SQLite file inside backend/)
DATABASE_URL=sqlite:///./app.db
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# JWT signing secret (change in any real deployment) and token lifetime
# at least 32 characters (HS256 recommendation)
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_EXPIRES_MINUTES=720
